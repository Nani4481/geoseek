# Deployment shell settings (bucket names, no gs:// prefix).
# These three are used by deployment tooling, not by Python rasterio.
GCS_BUCKET=geoseek-510206-archive
SATELLITE_DATA_PREFIX=datasets
MODEL_BUCKET=geoseek-510206-archive
# Runtime local paths AFTER mount/sync. Leave blank for existing defaults.
GEOSEEK_DATA_DIR=
GEOSEEK_DATASETS_DIR=
GEOSEEK_MODELS_DIR=
GEOSEEK_TILES_DIR=
GEOSEEK_INDEX_DIR=
GEOSEEK_PROVENANCE_PATH=
FAISS_INDEX_PATH=
# Linux example: sqlite:////app/data/index/tiles.sqlite
DATABASE_URL=
MODEL_PATH=
GEOSEEK_DEVICE=cpu
# The app does not auto-load .env. Pass selected variables via Docker/env.
