{
  "name": "geoseek-react",
  "private": true,
  "version": "0.1.0",
  "description": "GeoSeek React demo frontend (parallel to src/geoseek/analyst/web). Built output is served offline at /react/.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:pinned": "npm run build && python -m geoseek.staging.react_build_pins",
    "verify:offline": "node tools/verify-offline.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
